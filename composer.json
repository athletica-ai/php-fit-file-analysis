{
    "name": "adriangibbons/php-fit-file-analysis",
    "type": "library",
    "description": "A PHP class for analysing FIT files created by Garmin GPS devices",
    "keywords": [
        "garmin",
        "fit"
    ],
    "homepage": "https://github.com/adriangibbons/php-fit-file-analysis",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "adriangibbons\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "profile": "php bin/generate-profile.php",
        "profile-check": "php bin/generate-profile.php --check"
    }
}
